# Contributor: Zoey <zoey@z0ey.de>
maintainer="Zoey <zoey@z0ey.de>"
pkgname=dnsproxy
pkgver=0.86.0
pkgrel=0
pkgdesc="Simple DNS proxy with DoH, DoT, DoQ and DNSCrypt support"
url="https://github.com/AdguardTeam/dnsproxy"
arch="all"
license="Apache-2.0"
options="net !check" # net for go
depends="ca-certificates-bundle"
makedepends="go"
subpackages="$pkgname-openrc"
install="$pkgname.pre-install"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/AdguardTeam/dnsproxy/archive/v$pkgver.tar.gz
	dnsproxy.initd
	dnsproxy.confd
	"
pkgusers="dnsproxy"
pkggroups="dnsproxy"

prepare() {
	default_prepare

	# do not force a specific minor go version
	sed -Ei 's/^(go \d+\.\d+)\.\d*/\1.0/' go.mod

	go mod download
}

build() {
	go build -o bin/dnsproxy -trimpath -ldflags "-s -w
		-X github.com/AdguardTeam/golibs/version.version=v$pkgver
		-X github.com/AdguardTeam/golibs/version.committime=${SOURCE_DATE_EPOCH:-$(date +%s)}
		"
}

check() {
	go test ./...
}

package() {
	install -Dm755 bin/dnsproxy -t "$pkgdir"/usr/bin/
	install -Dm640 -g dnsproxy config.dist.yaml "$pkgdir"/etc/dnsproxy/config.yaml

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -Dm644 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname
}

sha512sums="
