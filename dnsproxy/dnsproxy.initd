#!/sbin/openrc-run

# fallback for /etc/conf.d/dnsproxy
: ${command_user:=dnsproxy:dnsproxy}
: ${cfgfile:="/etc/dnsproxy/config.yaml"}
: ${extra_args=""}

name=dnsproxy
description="Simple DNS proxy with DoH, DoT, DoQ and DNSCrypt support"
command="/usr/bin/dnsproxy"
command_args="--config-path=$cfgfile $extra_args"
command_background=true
pidfile="/run/dnsproxy.pid"
# bind_service for ports lower than 1024
capabilities="^cap_net_bind_service"

depend() {
	need net
	provide dns
	after firewall
}

start_pre() {
	if [ -n "$logdir" ]; then
		checkpath -d -o "$command_user" "$logdir"
	fi

	if [ -n "$output_log" ]; then
		checkpath -f -o "$command_user" "$output_log"
	fi

	if [ -n "$error_log" ]; then
		checkpath -f -o "$command_user" "$error_log"
	fi
}
